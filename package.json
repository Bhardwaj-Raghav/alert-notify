{
  "name": "alert-notify",
  "version": "3.0.0",
  "description": "Multi-framework toast notifications for React, Vue, Svelte, Angular, and vanilla JS. Alternative to react-toastify, react-hot-toast, and Sonner. No provider required. ~6KB gzip JS per path.",
  "license": "MIT",
  "author": "Raghav Bhardwaj",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js",
      "require": "./dist/react.cjs"
    },
    "./vue": {
      "types": "./dist/vue.d.ts",
      "import": "./dist/vue.js",
      "require": "./dist/vue.cjs"
    },
    "./svelte": {
      "types": "./dist/svelte/Toaster.svelte",
      "svelte": "./dist/svelte/Toaster.svelte",
      "default": "./dist/svelte/Toaster.svelte"
    },
    "./style.css": "./dist/style.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md",
    "CHANGELOG.md"
  ],
  "unpkg": "./dist/alert-notify.global.js",
  "jsdelivr": "./dist/alert-notify.global.js",
  "sideEffects": [
    "*.css"
  ],
  "scripts": {
    "build": "tsup && node scripts/copy-css.mjs",
    "dev": "vite --config playground/vite.config.ts",
    "dev:lib": "tsup --watch",
    "website": "astro dev --root website --port 5174",
    "website:build": "astro build --root website",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "size": "npm run build",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build -o storybook-static",
    "prepublishOnly": "npm run typecheck && npm run test && npm run build"
  },
  "peerDependencies": {
    "react": ">=17",
    "react-dom": ">=17",
    "svelte": ">=5",
    "vue": ">=3"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    },
    "vue": {
      "optional": true
    },
    "svelte": {
      "optional": true
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Bhardwaj-Raghav/alert-notify.git"
  },
  "bugs": {
    "url": "https://github.com/Bhardwaj-Raghav/alert-notify/issues"
  },
  "homepage": "https://alert-notify.vercel.app",
  "keywords": [
    "toast",
    "toast-notification",
    "toast-notifications",
    "notification",
    "notifications",
    "alert",
    "react-alert",
    "snackbar",
    "react-toast",
    "react-toastify",
    "toastify",
    "tostify",
    "react-hot-toast",
    "hot-toast",
    "sonner",
    "notistack",
    "react-notification",
    "react-notifications",
    "vue-toast",
    "svelte-toast",
    "angular-toast",
    "javascript-toast",
    "vanilla",
    "typescript",
    "framework-agnostic",
    "lightweight",
    "small",
    "zero-dependency"
  ],
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@astrojs/sitemap": "^3.7.3",
    "@eslint/js": "^9.39.5",
    "@storybook/addon-docs": "^10.5.2",
    "@storybook/html": "^10.5.2",
    "@storybook/html-vite": "^10.5.2",
    "@types/node": "^22.13.10",
    "@types/react": "^19.0.12",
    "@types/react-dom": "^19.2.4",
    "astro": "^7.1.1",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-storybook": "^10.5.7",
    "globals": "^15.15.0",
    "jsdom": "^26.0.0",
    "prettier": "^3.9.6",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "storybook": "^10.5.2",
    "svelte": "^5.0.0",
    "tsup": "^8.4.0",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.66.0",
    "vite": "^6.1.0",
    "vitest": "^3.0.9",
    "vue": "^3.5.13"
  }
}
