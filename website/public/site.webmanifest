{
  "name": "alert-notify",
  "short_name": "alert-notify",
  "description": "Tiny multi-framework toast library. No provider. Alternative to toastify, hot-toast, and Sonner.",
  "start_url": "/",
  "display": "standalone",
  "background_color": "#e8f2ef",
  "theme_color": "#0f766e",
  "icons": [
    {
      "src": "favicon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    },
    {
      "src": "favicon-32x32.png",
      "sizes": "32x32",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "apple-touch-icon.png",
      "sizes": "180x180",
      "type": "image/png",
      "purpose": "any"
    }
  ]
}
