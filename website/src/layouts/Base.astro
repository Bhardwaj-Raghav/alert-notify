---
import "alert-notify/style.css";
import "../styles/site.css";
import size from "../data/size.json";
import pkg from "../../../package.json";
import {
  siteName,
  description as defaultDescription,
  ogTitle as defaultOgTitle,
  title as defaultTitle,
  keywords as defaultKeywords,
  faqs,
  type OgType,
} from "../data/seo";
import { githubUrl, npmUrl } from "../data/nav";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";

type Breadcrumb = { name: string; href: string };

interface Props {
  title?: string;
  description?: string;
  ogTitle?: string;
  keywords?: string;
  ogType?: OgType;
  breadcrumbs?: Breadcrumb[];
  includeFaqSchema?: boolean;
  includeChrome?: boolean;
  /** TechArticle headline; defaults to title when ogType is article. */
  articleHeadline?: string;
}

const {
  title = defaultTitle,
  description = defaultDescription,
  ogTitle = defaultOgTitle,
  keywords,
  ogType = "website" as OgType,
  breadcrumbs = [{ name: "Home", href: "/" }],
  includeFaqSchema = false,
  includeChrome = true,
  articleHeadline,
} = Astro.props;

const baseURL = import.meta.env.BASE_URL.endsWith("/")
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const homeURL = new URL(baseURL, Astro.site);
const ogImageURL = new URL(`${baseURL}og-image.png`, Astro.site);
const sitemapURL = new URL(`${baseURL}sitemap.xml`, Astro.site);
const isHome =
  Astro.url.pathname === "/" ||
  Astro.url.pathname === "" ||
  Astro.url.pathname === baseURL.replace(/\/$/, "") ||
  Astro.url.pathname === baseURL;

const graph: Record<string, unknown>[] = [
  {
    "@type": "WebSite",
    "@id": `${homeURL.href}#website`,
    url: homeURL.href,
    name: siteName,
    alternateName: ["alert notify", "toast notification library"],
    description: defaultDescription,
    inLanguage: "en-US",
    publisher: { "@id": `${homeURL.href}#software` },
  },
  {
    "@type": "WebPage",
    "@id": `${canonicalURL.href}#webpage`,
    url: canonicalURL.href,
    name: title,
    description,
    isPartOf: { "@id": `${homeURL.href}#website` },
    about: { "@id": `${homeURL.href}#software` },
    primaryImageOfPage: {
      "@type": "ImageObject",
      url: ogImageURL.href,
      width: 1200,
      height: 630,
    },
    inLanguage: "en-US",
  },
];

if (isHome) {
  graph.push(
    {
      "@type": "SoftwareApplication",
      "@id": `${homeURL.href}#software`,
      name: siteName,
      alternateName: ["alert notify", "toast notification library"],
      applicationCategory: "DeveloperApplication",
      applicationSubCategory: "Toast notification library",
      operatingSystem: "Any",
      description: defaultDescription,
      url: homeURL.href,
      downloadUrl: npmUrl,
      installUrl: npmUrl,
      codeRepository: githubUrl,
      license: "https://opensource.org/licenses/MIT",
      keywords: defaultKeywords,
      featureList: [
        "React toast notifications",
        "Vue toast notifications",
        "Svelte toast notifications",
        "Angular toast messages",
        "Vanilla JS / CDN toasts",
        "Promise toast API",
        "Dark mode and CSS variables",
        "Zero runtime dependencies",
        "No root provider required",
      ],
      author: {
        "@type": "Person",
        name: "Raghav Bhardwaj",
      },
      offers: {
        "@type": "Offer",
        price: "0",
        priceCurrency: "USD",
        availability: "https://schema.org/InStock",
      },
      softwareVersion: pkg.version,
      softwareRequirements: "Node.js >= 18 for install via npm",
      fileSize: `${size.jsGzipKb}KB gzip JS`,
      screenshot: ogImageURL.href,
      sameAs: [githubUrl, npmUrl],
    },
    {
      "@type": "SoftwareSourceCode",
      "@id": `${homeURL.href}#source`,
      name: siteName,
      description: defaultDescription,
      codeRepository: githubUrl,
      programmingLanguage: ["TypeScript", "JavaScript"],
      runtimePlatform: ["Browser", "React", "Vue", "Svelte", "Angular", "Astro"],
      license: "https://opensource.org/licenses/MIT",
      url: homeURL.href,
    },
  );
}

if (ogType === "article") {
  graph.push({
    "@type": "TechArticle",
    "@id": `${canonicalURL.href}#article`,
    headline: articleHeadline ?? title,
    description,
    url: canonicalURL.href,
    isPartOf: { "@id": `${homeURL.href}#website` },
    about: { "@id": `${homeURL.href}#software` },
    inLanguage: "en-US",
  });
}

if (breadcrumbs.length > 1) {
  graph.push({
    "@type": "BreadcrumbList",
    "@id": `${canonicalURL.href}#breadcrumb`,
    itemListElement: breadcrumbs.map((crumb, index) => ({
      "@type": "ListItem",
      position: index + 1,
      name: crumb.name,
      item: new URL(crumb.href, Astro.site).href,
    })),
  });
}

if (includeFaqSchema) {
  graph.push({
    "@type": "FAQPage",
    "@id": `${canonicalURL.href}#faq`,
    mainEntity: faqs.map((faq) => ({
      "@type": "Question",
      name: faq.question,
      acceptedAnswer: {
        "@type": "Answer",
        text: faq.answer,
      },
    })),
  });
}

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": graph,
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {keywords && <meta name="keywords" content={keywords} />}
    <meta name="author" content="Raghav Bhardwaj" />
    <meta name="creator" content="Raghav Bhardwaj" />
    <meta name="publisher" content="alert-notify" />
    <meta
      name="robots"
      content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1"
    />
    <meta name="googlebot" content="index, follow" />
    <meta name="bingbot" content="index, follow" />
    <meta name="theme-color" content="#0f766e" />
    <meta name="color-scheme" content="light dark" />
    <meta name="format-detection" content="telephone=no" />
    <meta name="application-name" content={siteName} />
    <meta name="apple-mobile-web-app-title" content={siteName} />
    <meta name="referrer" content="strict-origin-when-cross-origin" />

    <link rel="canonical" href={canonicalURL} />
    <link rel="sitemap" type="application/xml" href={sitemapURL} />
    <link rel="alternate" type="text/plain" href={new URL(`${baseURL}llms.txt`, Astro.site)} title="llms.txt" />

    <link rel="icon" href={`${baseURL}favicon.svg`} type="image/svg+xml" />
    <link rel="icon" href={`${baseURL}favicon-32x32.png`} type="image/png" sizes="32x32" />
    <link rel="icon" href={`${baseURL}favicon-16x16.png`} type="image/png" sizes="16x16" />
    <link rel="apple-touch-icon" href={`${baseURL}apple-touch-icon.png`} sizes="180x180" />
    <link rel="manifest" href={`${baseURL}site.webmanifest`} />

    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={ogTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageURL} />
    <meta
      property="og:image:alt"
      content={`${siteName}: toast notifications for React, Vue, Svelte, and vanilla JS`}
    />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:see_also" content={githubUrl} />
    <meta property="og:see_also" content={npmUrl} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={ogTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL} />
    <meta
      name="twitter:image:alt"
      content={`${siteName}: toast notification library`}
    />
    <meta name="twitter:label1" content="Install" />
    <meta name="twitter:data1" content="npm i alert-notify" />
    <meta name="twitter:label2" content="Size" />
    <meta name="twitter:data2" content={`~${size.jsGzipKb}KB gzip JS`} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="preload"
      as="style"
      href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@400;500;600;700&family=Sora:wght@600;700;800&display=swap"
    />
    <link
      href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@400;500;600;700&family=Sora:wght@600;700;800&display=swap"
      rel="stylesheet"
      media="print"
      onload="this.media='all'"
    />
    <noscript>
      <link
        href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@400;500;600;700&family=Sora:wght@600;700;800&display=swap"
        rel="stylesheet"
      />
    </noscript>

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    <script is:inline>
      (function () {
        var key = "alert-notify-theme";
        var stored = null;
        try {
          stored = localStorage.getItem(key);
        } catch (_) {}
        var theme = stored === "dark" || stored === "light" ? stored : null;
        if (!theme) {
          theme = window.matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light";
        }
        document.documentElement.setAttribute("data-theme", theme);
      })();
    </script>
  </head>
  <body>
    {includeChrome && <SiteHeader />}
    <slot />
    {includeChrome && <SiteFooter />}
  </body>
</html>
