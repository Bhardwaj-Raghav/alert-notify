---
import DocsLayout from "../../layouts/DocsLayout.astro";
import { faqs } from "../../data/seo";
---

<DocsLayout
  title="FAQ · alert-notify"
  description="Frequently asked questions about alert-notify, React toasts, and toastify alternatives."
  pageTitle="FAQ"
  includeFaqSchema
>
  <div class="faq-list">
    {
      faqs.map((faq) => (
        <details class="faq-item">
          <summary>{faq.question}</summary>
          <p>{faq.answer}</p>
        </details>
      ))
    }
  </div>
</DocsLayout>
