---
import DocsLayout from "../../layouts/DocsLayout.astro";
import size from "../../data/size.json";
import { frameworks } from "../../data/nav";
---

<DocsLayout
  title="Docs · alert-notify"
  description="Documentation for alert-notify: install, framework guides, API, theming, FAQ, and migration."
  pageTitle="Overview"
>
  <p>
    alert-notify is a multi-framework toast library. Call <code>toast.success()</code> from anywhere.
    The portal auto-mounts. Optional helpers sync config for React, Vue, and Svelte.
    Measured size is about <strong>~{size.jsGzipKb}KB</strong> gzip JS + ~{size.cssGzipKb}KB CSS per path.
  </p>

  <h2>Support tiers</h2>
  <div class="table-wrap">
    <table>
      <thead>
        <tr><th>Tier</th><th>What it means</th><th>Stacks</th></tr>
      </thead>
      <tbody>
        <tr>
          <td><span class="tier native">Native</span></td>
          <td>Core package or CDN IIFE. Full API.</td>
          <td>Vanilla JS, CDN</td>
        </tr>
        <tr>
          <td><span class="tier helper">Helper</span></td>
          <td>First-class export that syncs config and may add framework custom helpers.</td>
          <td>React, Vue, Svelte</td>
        </tr>
        <tr>
          <td><span class="tier recipe">Recipe</span></td>
          <td>Documented use of the core API. No dedicated package export.</td>
          <td>Angular, Astro</td>
        </tr>
      </tbody>
    </table>
  </div>

  <h2>Start here</h2>
  <ul>
    <li><a href="/docs/install">Install</a></li>
    <li><a href="/docs/quick-start">Quick start</a></li>
    <li><a href="/examples">Playground</a></li>
  </ul>

  <h2>Pick a stack</h2>
  <ul>
    {
      frameworks.map((fw) => (
        <li>
          <a href={fw.docsHref}>{fw.label}</a>
          {" "}
          <span class={`tier ${fw.tier}`}>{fw.tierLabel}</span>
          {" · "}
          {fw.blurb}
        </li>
      ))
    }
    <li>
      <a href="/docs/astro">Astro</a>
      {" "}
      <span class="tier recipe">Recipe</span>
      {" · "}
      Client script or island using the core API.
    </li>
  </ul>
</DocsLayout>
