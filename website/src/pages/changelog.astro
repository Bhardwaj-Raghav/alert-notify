---
import Base from "../layouts/Base.astro";
import { releases, rewriteChangelogLinks } from "../data/releases";
import { pageMeta } from "../data/seo";

const meta = pageMeta({
  title: "alert-notify: Changelog",
  description:
    "Release history for alert-notify, including 3.1 per-toast options and framework icons, the 3.0 message-first API, and earlier 2.x / 1.x lines.",
});

/** Escape HTML, then light markdown: `code` and [label](href). */
function formatInline(text: string): string {
  const escaped = text
    .replace(/&/g, "&amp;")
    .replace(/</g, "&lt;")
    .replace(/>/g, "&gt;");
  return rewriteChangelogLinks(escaped)
    .replace(
      /\[([^\]]+)\]\(([^)]+)\)/g,
      '<a href="$2">$1</a>',
    )
    .replace(/`([^`]+)`/g, "<code>$1</code>");
}
---

<Base
  title={meta.title}
  description={meta.description}
  ogTitle={meta.ogTitle}
  breadcrumbs={[
    { name: "Home", href: "/" },
    { name: "Changelog", href: "/changelog" },
  ]}
>
  <main class="page-shell">
    <section class="section">
      <h1 style="margin:0;font-size:clamp(2rem,4vw,2.8rem)">Changelog</h1>
      <p class="section-copy">
        From the package <code>CHANGELOG.md</code>. Latest is <strong>3.1.0 </strong>
        (per-toast options, framework icons, icon/progress colors).
        See <a href="/docs/migration">Migration</a> for upgrade tables from 1.x / 2.x.
      </p>
      {
        releases.map((release) => (
          <article class="release">
            <div class="release-head">
              <h2>
                {release.href ? (
                  <a href={release.href}>{release.version}</a>
                ) : (
                  release.version
                )}
              </h2>
              {release.date && <time class="release-date" datetime={release.date}>{release.date}</time>}
              {release.status && <span class="release-status">{release.status}</span>}
            </div>
            {release.sections.map((section) => (
              <div class="release-section">
                {section.title && <h3>{section.title}</h3>}
                {section.blocks.map((block) =>
                  block.type === "list" ? (
                    <ul class="notes">
                      {block.items.map((item) => (
                        <li set:html={formatInline(item)} />
                      ))}
                    </ul>
                  ) : block.type === "paragraph" ? (
                    <p class="section-copy" set:html={formatInline(block.text)} />
                  ) : (
                    <pre class="api"><code>{block.code}</code></pre>
                  ),
                )}
              </div>
            ))}
          </article>
        ))
      }
    </section>
  </main>
</Base>
