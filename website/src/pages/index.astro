---
import Base from "../layouts/Base.astro";
import InstallCopy from "../components/InstallCopy.astro";
import size from "../data/size.json";
import pkg from "../../../package.json";
import { description, keywords, ogTitle, title } from "../data/seo";

const getRunning = [
  {
    id: "react",
    label: "React",
    href: "/react",
    code: `import { toast } from "alert-notify";
import { Toaster } from "alert-notify/react";

export function App() {
  return (
    <>
      <Toaster position="top-right" richColors />
      <button onClick={() => toast.success("Saved")}>Save</button>
    </>
  );
}`,
  },
  {
    id: "vanilla",
    label: "Vanilla",
    href: "/docs/quick-start",
    code: `import { toast } from "alert-notify";

toast.config({ position: "top-right", richColors: true });
toast.success("Saved");`,
  },
  {
    id: "cdn",
    label: "CDN",
    href: "/cdn",
    code: `<script src="https://unpkg.com/alert-notify@3/dist/alert-notify.global.js"></script>
<script>
  AlertNotify.toast.success("Hello from CDN");
</script>`,
  },
  {
    id: "vue",
    label: "Vue",
    href: "/vue",
    code: `<script setup>
import { toast } from "alert-notify";
import { Toaster } from "alert-notify/vue";
</script>

<template>
  <Toaster position="top-right" :rich-colors="true" />
  <button @click="toast.success('Saved')">Save</button>
</template>`,
  },
  {
    id: "svelte",
    label: "Svelte",
    href: "/svelte",
    code: `<script>
  import { toast } from "alert-notify";
  import Toaster from "alert-notify/svelte";
</script>

<Toaster position="top-right" richColors />
<button onclick={() => toast.success("Saved")}>Save</button>`,
  },
  {
    id: "angular",
    label: "Angular",
    href: "/angular",
    code: `import { toast } from "alert-notify";

toast.config({ position: "top-right", richColors: true });
toast.success("Saved");`,
  },
] as const;
---

<Base title={title} description={description} ogTitle={ogTitle} keywords={keywords}>
  <main class="home">
    <section class="home-hero">
      <p class="home-eyebrow">
        v{pkg.version} · React · Vanilla · Vue · Svelte · Angular · and more
      </p>
      <h1>alert-notify</h1>
      <p class="home-tagline">Toast notifications for any framework.</p>
      <p class="home-lede">
        Same imperative API in React, Vue, Svelte, Angular, Astro, or a CDN script.
        No root provider. About ~{size.jsGzipKb}KB gzip JS + ~{size.cssGzipKb}KB CSS per path.
      </p>
      <div class="home-cta">
        <a class="btn primary" href="/examples">Open examples</a>
        <a class="btn" href="/docs">Read docs</a>
      </div>
      <div class="home-install">
        <InstallCopy command="npm install alert-notify" />
      </div>
    </section>

    <section class="home-stage panel" data-home-stage>
      <div class="tabs home-stage-tabs" role="tablist" aria-label="Toast modes">
        <button type="button" class="tab active" role="tab" aria-selected="true" data-mode-tab="success">Success</button>
        <button type="button" class="tab" role="tab" aria-selected="false" data-mode-tab="error">Error</button>
        <button type="button" class="tab" role="tab" aria-selected="false" data-mode-tab="promise">Promise</button>
        <button type="button" class="tab" role="tab" aria-selected="false" data-mode-tab="undo">Undo</button>
        <button type="button" class="tab" role="tab" aria-selected="false" data-mode-tab="stack">Stack</button>
        <button type="button" class="tab" role="tab" aria-selected="false" data-mode-tab="dark">Dark</button>
      </div>

      <div class="home-stage-body">
        <p class="home-stage-readout" data-home-readout>Mode: success · position top-right · richColors on</p>
        <button type="button" data-toast="dismiss" class="btn home-stage-dismiss">Dismiss all</button>
      </div>

      <pre class="home-stage-code"><code data-home-code></code></pre>
    </section>

    <section class="home-section">
      <h2>Get running</h2>
      <p class="section-copy home-center-copy">
        Install once, then import the entry for your stack. Tabs below show the shortest path for each.
      </p>
      <div class="tabs" role="tablist" aria-label="Framework install paths" data-get-running>
        {
          getRunning.map((item, i) => (
            <button
              type="button"
              class:list={["tab", { active: i === 0 }]}
              role="tab"
              aria-selected={i === 0}
              data-run-tab={item.id}
              data-run-href={item.href}
              data-run-label={item.label}
            >
              {item.label}
            </button>
          ))
        }
      </div>
      <div class="home-code-wrap">
        <button type="button" class="home-copy-code" data-copy-code>Copy</button>
        {
          getRunning.map((item, i) => (
            <pre class:list={["tab-panel", "home-run-panel", { active: i === 0 }]} data-run-panel={item.id}><code>{item.code}</code></pre>
          ))
        }
      </div>
      <p class="home-deep-link">
        <a href="/react" data-run-link>Open the React page →</a>
      </p>
    </section>

    <section class="home-section">
      <h2>Built for real apps</h2>
      <div class="home-features">
        <article>
          <h3>Works everywhere</h3>
          <p>
            Native core for any JS. Helper exports for React, Vue, and Svelte.
            Angular and Astro use the same API as recipes.
          </p>
        </article>
        <article>
          <h3>No provider required</h3>
          <p>
            The portal auto-mounts. Optional Toaster wrappers only sync config props.
            Call toast.success from anywhere.
          </p>
        </article>
        <article>
          <h3>Promise and actions</h3>
          <p>
            Loading to success or error on one id, Undo buttons, stacking, swipe dismiss,
            and pause on hover or blur.
          </p>
        </article>
        <article>
          <h3>Theme and size</h3>
          <p>
            light, dark, and system themes plus richColors and CSS variables.
            About ~{size.jsGzipKb}KB gzip JS per path, zero runtime deps.
          </p>
        </article>
      </div>
    </section>

    <section class="home-banner">
      <div>
        <h2>Try it live</h2>
        <p>Tune options in the playground, or open a framework page for install notes and a focused demo.</p>
      </div>
      <a class="btn primary" href="/examples">Open playground</a>
    </section>
  </main>
</Base>

<script>
  import {
    applyDemoConfig,
    bindToastButtons,
    buildHomeSnippet,
    fireToast,
    syncToastThemeWithSite,
    type HomeMode,
  } from "../scripts/toast-demo";

  const stage = document.querySelector("[data-home-stage]");
  const codeEl = document.querySelector("[data-home-code]");
  const readout = document.querySelector("[data-home-readout]");

  let mode: HomeMode = "success";

  function siteTheme() {
    return syncToastThemeWithSite();
  }

  function applyMode(next: HomeMode) {
    mode = next;
    const theme = next === "dark" ? "dark" : siteTheme();
    applyDemoConfig({
      position: "top-right",
      richColors: true,
      progressBar: true,
      theme,
      visibleToasts: next === "stack" ? 5 : 3,
    });
    if (codeEl) codeEl.textContent = buildHomeSnippet(mode);
    if (readout) {
      const stackNote = next === "stack" ? " · visibleToasts 5" : "";
      readout.textContent = `Mode: ${mode} · position top-right · richColors on · theme ${theme}${stackNote}`;
    }
  }

  applyMode("success");
  const unbind = bindToastButtons(stage ?? document);

  document.querySelectorAll("[data-mode-tab]").forEach((tab) => {
    tab.addEventListener("click", () => {
      const next = tab.getAttribute("data-mode-tab") as HomeMode | null;
      if (!next) return;
      document.querySelectorAll("[data-mode-tab]").forEach((el) => {
        const active = el === tab;
        el.classList.toggle("active", active);
        el.setAttribute("aria-selected", active ? "true" : "false");
      });
      applyMode(next);
      fireToast(next === "dark" ? "success" : next);
    });
  });

  window.addEventListener("alert-notify:theme", ((event: CustomEvent<{ theme: "light" | "dark" }>) => {
    if (mode !== "dark") applyDemoConfig({ theme: event.detail.theme });
  }) as EventListener);

  const runRoot = document.querySelector("[data-get-running]");
  const runLink = document.querySelector("[data-run-link]");
  const copyCodeBtn = document.querySelector("[data-copy-code]");

  function activeRunPanel() {
    return document.querySelector(".home-run-panel.active code");
  }

  runRoot?.querySelectorAll("[data-run-tab]").forEach((tab) => {
    tab.addEventListener("click", () => {
      const id = tab.getAttribute("data-run-tab");
      const href = tab.getAttribute("data-run-href");
      const label = tab.getAttribute("data-run-label");
      runRoot.querySelectorAll("[data-run-tab]").forEach((el) => {
        const active = el === tab;
        el.classList.toggle("active", active);
        el.setAttribute("aria-selected", active ? "true" : "false");
      });
      document.querySelectorAll("[data-run-panel]").forEach((panel) => {
        panel.classList.toggle("active", panel.getAttribute("data-run-panel") === id);
      });
      if (runLink instanceof HTMLAnchorElement && href && label) {
        runLink.href = href;
        runLink.textContent = `Open the ${label} page →`;
      }
    });
  });

  copyCodeBtn?.addEventListener("click", async () => {
    const code = activeRunPanel()?.textContent ?? "";
    if (!code) return;
    try {
      await navigator.clipboard.writeText(code);
    } catch {
      /* ignore */
    }
    if (copyCodeBtn instanceof HTMLElement) {
      copyCodeBtn.textContent = "Copied";
      window.setTimeout(() => {
        copyCodeBtn.textContent = "Copy";
      }, 1200);
    }
  });

  document.addEventListener("astro:before-swap", () => unbind(), { once: true });
</script>
