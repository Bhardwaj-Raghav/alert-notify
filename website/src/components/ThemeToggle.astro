---
---

<button type="button" class="theme-toggle" data-theme-toggle aria-label="Switch to dark theme" title="Toggle theme">
  <svg class="theme-icon theme-icon-sun" width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true">
    <circle cx="12" cy="12" r="4" stroke="currentColor" stroke-width="2"></circle>
    <path
      d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
    ></path>
  </svg>
  <svg class="theme-icon theme-icon-moon" width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true">
    <path
      d="M21 14.5A8.5 8.5 0 0 1 9.5 3 7 7 0 1 0 21 14.5Z"
      stroke="currentColor"
      stroke-width="2"
      stroke-linejoin="round"
    ></path>
  </svg>
</button>

<script>
  const key = "alert-notify-theme";

  function currentTheme(): "light" | "dark" {
    const value = document.documentElement.getAttribute("data-theme");
    return value === "dark" ? "dark" : "light";
  }

  function setTheme(theme: "light" | "dark") {
    document.documentElement.setAttribute("data-theme", theme);
    try {
      localStorage.setItem(key, theme);
    } catch {
      /* ignore */
    }
    document.querySelectorAll("[data-theme-toggle]").forEach((btn) => {
      btn.setAttribute(
        "aria-label",
        theme === "dark" ? "Switch to light theme" : "Switch to dark theme",
      );
    });
    window.dispatchEvent(new CustomEvent("alert-notify:theme", { detail: { theme } }));
  }

  document.querySelectorAll("[data-theme-toggle]").forEach((btn) => {
    if (!(btn instanceof HTMLButtonElement)) return;
    if (btn.dataset.bound === "1") return;
    btn.dataset.bound = "1";
    btn.setAttribute(
      "aria-label",
      currentTheme() === "dark" ? "Switch to light theme" : "Switch to dark theme",
    );
    btn.addEventListener("click", () => {
      setTheme(currentTheme() === "dark" ? "light" : "dark");
    });
  });
</script>
